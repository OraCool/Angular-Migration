{
  "name": "angular-migration-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Angular migration tools (ACP agent and MCP server)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:acp": "npm run dev --workspace=packages/acp-agent",
    "dev:mcp": "npm run dev --workspace=packages/mcp-server",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "mcp:build": "npm run build --workspace=@angular-migration/workflow-engine && npm run build --workspace=@angular-migration/mcp-server"
  },
  "keywords": [
    "angular",
    "migration",
    "monorepo",
    "acp",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
