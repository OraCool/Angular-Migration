# Angular Migration Agent Configuration
# Copy this file to .env and adjust paths as needed

# Workshop Configuration
# Path to the Angular Migration Workshop directory
# Default: ~/.angular-migration/workshop
# WORKSHOP_ROOT=/path/to/your/workshop

# Checkpoint Configuration
# Directory where migration checkpoints are stored (for resume functionality)
# Default: ~/.angular-migration/checkpoints
# CHECKPOINT_DIR=/path/to/your/checkpoints

# Project Configuration
# Override default project path if needed
# PROJECT_ROOT=/path/to/your/angular/project

# Workflow Options
# Skip test execution during migration
# SKIP_TESTS=false

# Skip linting during migration
# SKIP_LINT=false

# Auto-confirm all migration steps (use with caution!)
# AUTO_CONFIRM=false
